{"file":"SectionHeading-DOTHL2r2.js","mappings":";;;;;;;;;;;;;;;;UAoBU,QAAA,SAAO;;UACZ,SAAS,QAAQ,QAAA,OAAO;AAAA,UACxB,UAAU,QAAQ,QAAA,QAAQ;AAAA,UAC1B,OAAO,QAAA;AAAA,UACP,OAAO;AAAA,QAAA;;;UAIP,OAAc,QAAA,UAAK;;YAOZ,QAAA,SAAO;8GAGV,QAAA,OAAO,CAAA,MAAA;AAAA;;;2HAKP,QAAA,KAAK,CAAA,OAAA;YAGF,QAAA,UAAQ;sGAGX,QAAA,QAAQ,CAAA,MAAA;AAAA;;;;;;;;;;;;;;;","names":[],"sources":["../../../../../../../app/components/ui/SectionHeading.vue"],"sourcesContent":["<script setup lang=\"ts\">\ninterface Props {\n  eyebrow?: string;\n  title: string;\n  subtitle?: string;\n  align?: \"left\" | \"center\";\n  /** When true, renders a skeleton placeholder instead of the real text. */\n  loading?: boolean;\n}\n\nwithDefaults(defineProps<Props>(), {\n  align: \"center\",\n  eyebrow: undefined,\n  subtitle: undefined,\n  loading: false,\n});\n</script>\n\n<template>\n  <SkeletonBlock\n    v-if=\"loading\"\n    :eyebrow=\"Boolean(eyebrow)\"\n    :subtitle=\"Boolean(subtitle)\"\n    :align=\"align\"\n    :cards=\"0\"\n  />\n  <div\n    v-else\n    :class=\"\n      align === 'center'\n        ? 'mx-auto max-w-3xl text-center'\n        : 'max-w-2xl text-left'\n    \"\n  >\n    <p\n      v-if=\"eyebrow\"\n      class=\"mb-3 text-xs font-bold uppercase tracking-[0.2em] text-brand-500\"\n    >\n      {{ eyebrow }}\n    </p>\n    <h2\n      class=\"text-3xl font-extrabold leading-tight text-ink-900 dark:text-white md:text-4xl\"\n    >\n      {{ title }}\n    </h2>\n    <p\n      v-if=\"subtitle\"\n      class=\"mt-4 text-base text-ink-500 dark:text-ink-200 md:text-lg\"\n    >\n      {{ subtitle }}\n    </p>\n  </div>\n</template>\n"],"version":3}